# 复制为 .env 后填写；.env 不要提交
POSTGRES_USER=insight
POSTGRES_PASSWORD=换成强密码
POSTGRES_DB=insight
# 生产必须替换：openssl rand -hex 32
JWT_SECRET=

# ---- 大模型（W9）----
# mock=占位回复；openai=任何 OpenAI 兼容服务（DeepSeek/Qwen/vLLM/Ollama 均可）
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# 计费（元/百万 token），按实际模型改
LLM_PRICE_IN_PER_1M=1.0
LLM_PRICE_OUT_PER_1M=2.0
